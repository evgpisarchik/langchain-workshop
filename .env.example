# OpenAI-compatible LLM gateway
OPENAI_BASE_URL=https://llm-gateway.example.com/v1
OPENAI_API_KEY=sk-...
LLM_MODEL=your-model-name
# low | medium | high - reasoning effort (low keeps examples fast)
LLM_REASONING_EFFORT=low
# Embeddings service (KServe v2 inference endpoint). Empty -> local fallback
EMBEDDINGS_URL=http://embeddings.example.com:8000/v2/models/your-embedding-model/infer

# Optional: LangSmith tracing (see 08_production)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langchain-examples
